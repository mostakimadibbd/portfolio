# Portfolio Configuration
# Copy this file to .env and adjust values as needed.
# All values have sensible defaults — .env is optional.

# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
SITE_URL=http://localhost:3000

# ──────────────────────────────────────────────
# Security
# ──────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS.
# Use * for development; restrict in production.
CORS_ORIGINS=*

# Global API rate limit (per IP per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Strict rate limit for contact form (per IP per window)
CONTACT_RATE_LIMIT_WINDOW_MS=600000
CONTACT_RATE_LIMIT_MAX=5

# ──────────────────────────────────────────────
# Mail Relay (optional)
# ──────────────────────────────────────────────
# Any HTTP mail relay accepting JSON POST (Resend, Postmark, SendGrid webhook, etc.)
# If not set, contact messages are only persisted to disk and logged.
MAIL_ENDPOINT=
MAIL_API_KEY=
MAIL_FROM=Portfolio <onboarding@resend.dev>
MAIL_TO=

# ──────────────────────────────────────────────
# Storage
# ──────────────────────────────────────────────
# Where contact enquiries are written (directory must be writable)
MESSAGES_FILE=./var/messages.json
MAX_STORED_MESSAGES=500

# ──────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info